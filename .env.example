# X Analytics Free - Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# APP SETTINGS
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============================================
# DATABASE (SQLite file path)
# ============================================
DATABASE_PATH=./data/x-analytics.db

# ============================================
# X OAUTH 2.0 CREDENTIALS
# Get these from: https://developer.x.com/en/portal/projects-and-apps
# Create a project → App → "User authentication settings" → Type: "Public client" (for PKCE)
# ============================================
X_CLIENT_ID=your_client_id_here
X_CLIENT_SECRET=your_client_secret_here  # Optional for PKCE public clients
X_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================
# ENCRYPTION (generate with: openssl rand -base64 32)
# Used to encrypt stored OAuth tokens
# ============================================
ENCRYPTION_KEY=your_32_byte_base64_key_here

# ============================================
# SESSION (generate with: openssl rand -base64 32)
# ============================================
SESSION_SECRET=your_session_secret_here

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info